# ── Runtime ────────────────────────────────────────────────────────────────────
APP_ENV=production
# In Docker the compose file injects DATABASE_URL pointing at the "db" service.
# For local dev against SQLite:
#   DATABASE_URL=sqlite+aiosqlite:///./smart_qora.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_qora

# ── Model / inference ─────────────────────────────────────────────────────────
MODEL_PATH=models/best.pt
DEVICE=0                       # "0" = first CUDA GPU, "cpu" to force CPU
REQUIRE_CUDA=true              # fail startup instead of silently falling back to CPU
HALF_PRECISION=true            # FP16 inference on CUDA
CONFIDENCE=0.25                # 0..1
IOU=0.70                       # 0..1
IMG_SIZE=1280                  # multiple of 32, 320..1920
TRACKER=botsort.yaml          # or bytetrack.yaml
ALLOWED_CLASSES=sheep,cattle,goat,horse   # empty = every class in the model

# ── Seed camera (bootstrap defaults only — edit later in the Settings page) ────
DEFAULT_CAMERA_NAME=Gate 01
DEFAULT_CAMERA_SOURCE=         # empty falls back to VIDEO_SOURCE
VIDEO_SOURCE=videos/test.mp4   # file path, webcam index (0), or rtsp://user:pass@host/stream
FRAME_SKIP=0
STREAM_FPS=12
VIDEO_LOOP=true            # replay a video-FILE source forever (keeps the live preview running); ignored for RTSP/webcam
COUNT_LINE_P1_X=100
COUNT_LINE_P1_Y=400
COUNT_LINE_P2_X=1100
COUNT_LINE_P2_Y=400
INSIDE_DIRECTION=DOWN          # UP | DOWN | LEFT | RIGHT

# ── Auth ──────────────────────────────────────────────────────────────────────
# In Docker these are injected by compose from the root .env; set them here only
# for a non-Docker run.
SECRET_KEY=                    # long random string; REQUIRED in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # REQUIRED in production; seeds the admin on first boot only
ACCESS_TOKEN_TTL_HOURS=12

# ── Localisation / notifications ─────────────────────────────────────────────
DEFAULT_LANGUAGE=ru            # ru | kk | en | tr
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AGGREGATION_SECONDS=5

# ── CORS ─────────────────────────────────────────────────────────────────────
# Leave empty in the single-box image (frontend is served same-origin via nginx).
# For split dev servers list explicit origins; "*" is rejected.
CORS_ORIGINS=
